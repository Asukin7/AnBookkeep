        "name": "backup_revision_category_renamed",
        "sql": "CREATE TRIGGER backup_revision_category_renamed AFTER UPDATE OF name ON categories\nWHEN old.name IS NOT new.name\n    AND EXISTS (SELECT 1 FROM transactions WHERE category_id = new.id)\nBEGIN\n    UPDATE backup_revisions SET revision = revision + 1 WHERE id = 1;\nEND;"
