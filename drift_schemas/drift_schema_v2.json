    {
      "name": "backup_revisions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"backup_revisions\" (\"id\" INTEGER NOT NULL PRIMARY KEY CHECK (id = 1), \"revision\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"type\" INTEGER NOT NULL CHECK (type IN (0, 1)), \"name\" TEXT NOT NULL, \"icon_code\" TEXT NOT NULL, \"color_value\" INTEGER NOT NULL, \"sort_order\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"type\" INTEGER NOT NULL CHECK (type IN (0, 1)), \"category_id\" TEXT NOT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"amount_minor\" INTEGER NOT NULL CHECK (amount_minor BETWEEN 0 AND 99999999999), \"note\" TEXT NULL, \"occurred_at\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "backup_revision_added",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER backup_revision_added AFTER INSERT ON transactions BEGIN UPDATE backup_revisions SET revision = revision + 1 WHERE id = 1;END"
        }
      ]
    },
    {
      "name": "backup_revision_deleted",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER backup_revision_deleted AFTER DELETE ON transactions BEGIN UPDATE backup_revisions SET revision = revision + 1 WHERE id = 1;END"
