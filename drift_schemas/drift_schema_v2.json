      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER backup_revision_edited AFTER UPDATE OF type, category_id, amount_minor, note, occurred_at ON transactions WHEN old.type IS NOT new.type OR old.category_id IS NOT new.category_id OR old.amount_minor IS NOT new.amount_minor OR old.note IS NOT new.note OR old.occurred_at IS NOT new.occurred_at BEGIN UPDATE backup_revisions SET revision = revision + 1 WHERE id = 1;END"
        }
      ]
    },
